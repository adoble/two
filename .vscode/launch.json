    "version": "0.2.0",
    "configurations": [

        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'two'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=two",
                    "--package=two"
                ],
                "filter": {
                    "name": "two",
                    "kind": "bin"
                }
            },
            "args": ["/home/andrew/Downloads/SoftwareTools.html",  "-o",  "/home/andrew/Downloads/output" ,"--tiddler" ,"RustResources"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'two'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=two",
                    "--package=two"
                ],
                "filter": {
                    "name": "two",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}